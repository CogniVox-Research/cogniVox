# ============================================================
# CogniVox — RunPod Gateway (NGINX)
# Uses envsubst to inject service hostnames at startup
# ============================================================

FROM nginx:alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy the template
COPY docker/runpod/nginx.conf.template /etc/nginx/templates/nginx.conf.template

# Default values (override via RunPod environment variables)
ENV AUTH_SERVICE_HOST=localhost:8010
ENV DOCUMENT_SERVICE_HOST=localhost:8003
ENV GAME_SERVICE_HOST=localhost:8004
ENV LLM_SERVICE_HOST=localhost:8013
ENV TRANSCRIPT_SERVICE_HOST=localhost:8005
ENV SDS_SERVICE_HOST=localhost:8006

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -sf http://localhost/health || exit 1

# nginx:alpine image automatically runs envsubst on files in
# /etc/nginx/templates/*.template and writes output to /etc/nginx/conf.d/
# We need the output to be the main nginx.conf instead, so we do it manually.
CMD ["/bin/sh", "-c", "envsubst '${AUTH_SERVICE_HOST} ${DOCUMENT_SERVICE_HOST} ${GAME_SERVICE_HOST} ${LLM_SERVICE_HOST} ${TRANSCRIPT_SERVICE_HOST} ${SDS_SERVICE_HOST}' < /etc/nginx/templates/nginx.conf.template > /etc/nginx/nginx.conf && nginx -g 'daemon off;'"]
