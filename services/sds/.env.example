# SDS Service Environment Variables - EXAMPLE
# Copy this file to .env and fill in your actual API key

# Google Gemini API Key for AI-powered feedback generation
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (optional - defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
